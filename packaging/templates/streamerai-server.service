[Unit]
Description=StreamerAI local home server
After=network.target

[Service]
Type=simple
User=streamerai
Group=streamerai
Environment=STREAMERAI_STATE_ROOT=/var/lib/streamerai
EnvironmentFile=-/var/lib/streamerai/server.env
WorkingDirectory=/var/lib/streamerai
ExecStart=/opt/streamerai/current/runtime/node /opt/streamerai/current/service/start.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/streamerai

[Install]
WantedBy=multi-user.target
