# Non-secret local runtime settings. Provider credentials are entered through the
# guided setup UI and stored by the local secret-store adapter, never in this file.
STREAMERAI_HOST=127.0.0.1
STREAMERAI_PORT=4400
STREAMERAI_DATA_DIR=./data
STREAMERAI_WEB_ORIGIN=http://localhost:5173
# trace/debug: detailed diagnostics; info: summaries; warn/error/fatal; silent: off.
# Applied at server startup, including Docker Compose.
STREAMERAI_LOG_LEVEL=info

# Docker/production: use encrypted-file and mount the 32-byte key read-only.
# The vault belongs in the persistent data volume; the key must not.
STREAMERAI_SECRET_BACKEND=memory
# STREAMERAI_SECRET_KEY_FILE=/run/secrets/streamerai_master_key
# STREAMERAI_SECRET_VAULT_FILE=/app/data/secrets.vault

TMDB_BASE_URL=https://api.themoviedb.org/3
INFERENCE_PROVIDER=ollama
STREAMERAI_AGENT_MODE=api
STREAMERAI_AGENT_PROVIDER=ollama
# The default reasoning effort is low. Valid values: none|low|medium|high.
STREAMERAI_AGENT_REASONING_EFFORT=low
# Remote API mode: provider=openai|anthropic|gemini|grok|kimi|deepseek;
# model selection is automatic unless STREAMERAI_AGENT_MODEL is set.
# Save its API key through /api/v1/inference/api-credential.
# STREAMERAI_AGENT_MODEL=
# Native local-agent mode: set MODE=local and PROVIDER=codex or claude.
# The server process must run under the same OS account as the signed-in CLI.
# STREAMERAI_CODEX_COMMAND=codex
# STREAMERAI_CLAUDE_COMMAND=claude
# MCP stdio bridge only: local address of the running StreamerAI server or web proxy.
# STREAMERAI_MCP_BASE_URL=http://127.0.0.1:4400
INFERENCE_BASE_URL=http://127.0.0.1:11434
INFERENCE_MODEL=qwen3.5:4b
INFERENCE_CONTEXT_TOKENS=4096
INFERENCE_MAX_OUTPUT_TOKENS=512
INFERENCE_TIMEOUT_MS=60000
OLLAMA_MINIMUM_VERSION=0.5.0

SYNC_PROVIDER=local
WEB_SEARCH_PROVIDER=disabled
