{
  "name": "streamer-ai",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, conversational film and series discovery app with guided provider integrations.",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.7 <26",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @streamer-ai/server --filter @streamer-ai/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:init": "node scripts/generate-master-key.mjs",
    "distribution:runtime": "node scripts/distribution/build-runtime.mjs",
    "distribution:bundle": "node scripts/distribution/bundle.mjs",
    "distribution:test": "node --test scripts/distribution/*.test.mjs",
    "distribution:sign": "node scripts/distribution/create-release.mjs",
    "distribution:verify": "node scripts/distribution/verify-release.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "^3.2.4"
  }
}
