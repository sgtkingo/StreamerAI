{
  "name": "@streamer-ai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "start": "node dist/start.js",
    "mcp": "node dist/mcp/stdio.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@streamer-ai/discovery": "workspace:*",
    "@streamer-ai/contracts": "workspace:*",
    "@streamer-ai/database": "workspace:*",
    "fastify": "^5.6.1",
    "qrcode": "1.5.4",
    "pino": "^9.9.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
